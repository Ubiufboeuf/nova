---
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'

interface Props {
	title?: string
	className?: string
}

const { title, className = '' } = Astro.props

const savedTheme = Astro.cookies.get('nova-theme')?.value
---

<!doctype html>
<html lang='es' data-theme={savedTheme}>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<title>{title ? `${title} - ` : ''}Nova</title>
		<link rel='preload' href='/Inter.woff2' as='font' type='font/woff2' crossorigin='anonymous' />
		<script is:inline>
      if (!document.documentElement.dataset.theme) {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light'
      }
    </script>
	</head>
	<body>
		<Header />
		<main class={className}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
