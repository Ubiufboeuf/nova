---
import { GlobalSearchBar } from './header/GlobalSearchBar'
import HeaderActions from './header/HeaderActions.astro'

const navigation = [
  { href: '/category/technology', label: 'Tecnología' },
  { href: '/category/audio', label: 'Audio' },
  { href: '/category/gaming', label: 'Gaming' },
  { href: '/category/home', label: 'Hogar' },
  { href: '/category/electrodomestics', label: 'Electrodomésticos' },
  { href: '/category/accesories', label: 'Accesorios' },
  { href: '/category/offers', label: 'Ofertas' },
  { href: '/category/news', label: 'Novedades' }
]
---

<header class='sticky top-0 w-full h-fit bg-page'>
  <div class='h-16 flex items-center gap-2 p-3 border-b border-slate-200'>
    <a href='/' class='h-fit w-fit flex text-2xl font-black p-1 px-2'>
      NOVA
      <span class='text-accent'>.</span>
    </a>
    <GlobalSearchBar />
    <HeaderActions />
  </div>
  <nav class='h-12 flex items-center gap-2 p-2 px-3 border-b border-slate-200'>
    { navigation.map(({ href, label }) => (
      <a href={href} class='h-full flex items-center text-sm font-medium px-2 transition-colors text-slate-800 hover:text-accent'>{label}</a>
    )) }
    <a href='' class='ml-auto h-full flex items-center text-sm font-medium px-2 transition-colors text-slate-800 hover:text-accent'>Mis pedidos</a>
  </nav>
</header>