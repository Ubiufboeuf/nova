---
const footerSections = [
  {
    title: 'Atención al cliente',
    links: [
      { label: 'Centro de ayuda', href: '/help' },
      { label: 'Seguí tu pedido', href: '/orders/track' },
      { label: 'Medios de pago', href: '/payment-methods' },
      { label: 'Garantías', href: '/warranties' },
      { label: 'Contacto', href: '/contact' }
    ]
  },
  {
    title: 'Envíos y devoluciones',
    links: [
      { label: 'Costos y plazos de envío', href: '/shipping' },
      { label: 'Retiro en tienda', href: '/store-pickup' },
      { label: 'Cambios y devoluciones', href: '/returns' },
      { label: 'Botón de arrepentimiento', href: '/withdrawal' }
    ]
  },
  {
    title: 'Sobre NOVA',
    links: [
      { label: 'Quiénes somos', href: '/about' },
      { label: 'Nuestras tiendas', href: '/stores' },
      { label: 'Trabajá con nosotros', href: '/careers' },
      { label: 'Ventas corporativas', href: '/business' }
    ]
  },
  {
    title: 'Legal',
    links: [
      { label: 'Términos y condiciones', href: '/terms' },
      { label: 'Política de privacidad', href: '/privacy' },
      { label: 'Defensa del consumidor', href: '/consumer-rights' },
      { label: 'Bases de promociones', href: '/promotions/terms' }
    ]
  }
]
const cards = ['Visa', 'Mastercard', 'OCA', 'Creditel', 'Mercado Pago', 'Abitab']
---

<footer class='h-fit w-full bg-elev'>
  <div class='h-76 w-full grid grid-cols-[1.3fr_1fr_1fr_1fr_1fr] p-8 py-12 gap-5'>
    <div class='w-full flex flex-col gap-3'>
      <h1 class='h-fit w-fit flex text-2xl font-black'>
        NOVA
        <span class='text-accent'>.</span>
      </h1>
      <p class='text-sm text-pretty text-slate-500'>Tecnología, hogar y entretenimiento con envío a todo Uruguay desde 2009.</p>
      <div>
        <p class='text-sm text-pretty text-slate-600'><b>Casa central:</b> Av. 18 de Julio 1234, Montevideo</p>
        <p class='text-sm text-pretty text-slate-500'>Lun a Sáb de 9 a 21 h · 2900 1234</p>
      </div>
    </div>
    { footerSections.map(({ title, links }) => (
      <div class='w-full flex flex-col gap-3'>
        <strong class='text-sm font-semibold text-slate-700'>{title}</strong>
        <div class='flex flex-col gap-2'>
          { links.map(({ label, href }) => <a href={href} class='text-sm text-slate-500'>{label}</a>) }
        </div>
      </div>
    )) }
  </div>
  <div class='h-16 w-full flex items-center justify-between gap-2 px-8 border-t border-line'>
    <p class='text-xs font-light text-slate-500'>
      &copy;2026 NOVA (ponele :P) · Todos los precios incluyen IVA (también ponele :v).
    </p>
    <div class='flex items-center gap-2'>
      { cards.map((card) => <span class='text-xs border border-line bg-page rounded px-2 p-1'>{card}</span>) }
    </div>
  </div>
</footer>